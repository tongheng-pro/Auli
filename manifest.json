{
  "manifest_version": 3,
  "name": "Value List Auto Create",
  "version": "1.6.0",
  "description": "Bulk-create Value List items on hospitals.test, skipping duplicates. Includes EMR standard lookup values.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Value List Auto Create",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://hospitals.test/*",
    "https://hospitals.test/*",
    "https://emr-doc.pmrs2.org/*"
  ]
}
